<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Camera preview — fills entire screen -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Detection bounding-box overlay — same size as preview, drawn on top -->
    <com.dangerclassifier.DetectionOverlayView
        android:id="@+id/detectionOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top gradient fade (vignette) -->
    <View
        android:layout_width="0dp"
        android:layout_height="260dp"
        android:background="@drawable/bg_top_overlay"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Bottom gradient fade (vignette) -->
    <View
        android:layout_width="0dp"
        android:layout_height="280dp"
        android:background="@drawable/bg_bottom_overlay"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Top HUD: app name + score + level -->
    <LinearLayout
        android:id="@+id/scoreOverlay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="52dp"
        android:paddingBottom="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- App name chip -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WARNING.AI"
            android:textColor="#66FFFFFF"
            android:textSize="10sp"
            android:letterSpacing="0.3"
            android:layout_marginBottom="8dp" />

        <!-- Big score number -->
        <TextView
            android:id="@+id/scoreText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="@color/safe_green"
            android:textSize="88sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:lineSpacingMultiplier="1.0"
            android:includeFontPadding="false" />

        <!-- Score denominator -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="out of 10"
            android:textColor="#55FFFFFF"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:layout_marginTop="-4dp" />

        <!-- Level label + spinner row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/scoreLabelText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INITIALIZING"
                android:textColor="@color/safe_green"
                android:textSize="12sp"
                android:letterSpacing="0.25"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="8dp"
                android:visibility="gone"
                android:indeterminateTint="#77FFFFFF" />

        </LinearLayout>

    </LinearLayout>

    <!-- Bottom reasoning card -->
    <LinearLayout
        android:id="@+id/reasoningCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Section label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ANALYSIS"
            android:textColor="#55FFFFFF"
            android:textSize="9sp"
            android:letterSpacing="0.35"
            android:layout_marginBottom="6dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never">

            <TextView
                android:id="@+id/reasoningText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Waiting for camera…"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"
                android:lineSpacingMultiplier="1.55"
                android:fontFamily="sans-serif-light" />

        </ScrollView>

    </LinearLayout>

    <!-- Full-screen overlay: download / error -->
    <LinearLayout
        android:id="@+id/downloadOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#F0000000"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_warning_large"
            android:layout_marginBottom="24dp"
            android:contentDescription="Warning icon" />

        <ProgressBar
            android:id="@+id/downloadProgressBar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:indeterminateTint="@color/danger_orange"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/downloadStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/downloading_model"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:gravity="center"
            android:textStyle="bold"
            android:paddingHorizontal="36dp" />

        <TextView
            android:id="@+id/downloadSubText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/one_time_download"
            android:textColor="#88FFFFFF"
            android:textSize="13sp"
            android:gravity="center"
            android:paddingHorizontal="40dp"
            android:lineSpacingMultiplier="1.4" />

        <Button
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Retry"
            android:visibility="gone"
            android:backgroundTint="@color/danger_orange"
            android:textColor="#FFFFFF"
            android:paddingHorizontal="32dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
