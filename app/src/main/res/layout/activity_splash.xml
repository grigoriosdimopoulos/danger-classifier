<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient">

    <!-- Logo block — centered vertically in upper 55% -->
    <LinearLayout
        android:id="@+id/logoBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:alpha="0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/quoteBlock"
        app:layout_constraintVertical_bias="0.55">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_warning_large"
            android:contentDescription="Warning.AI logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Warning.AI"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:fontFamily="sans-serif-light" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Real-time Danger Detection"
            android:textColor="#88FFFFFF"
            android:textSize="13sp"
            android:letterSpacing="0.12" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:id="@+id/divider"
        android:layout_width="48dp"
        android:layout_height="1dp"
        android:background="#44FF4500"
        android:alpha="0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logoBlock"
        android:layout_marginTop="24dp" />

    <!-- Greek quote block — lower third -->
    <LinearLayout
        android:id="@+id/quoteBlock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="40dp"
        android:alpha="0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.78">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="\u201cThe bravest are surely those who have the clearest vision of what is before them \u2014 glory and danger alike \u2014 and yet notwithstanding, go out to meet it.\u201d"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.6"
            android:gravity="center"
            android:fontFamily="serif" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="\u2014 Thucydides, History of the Peloponnesian War (431 BC)"
            android:textColor="#77FF4500"
            android:textSize="11sp"
            android:letterSpacing="0.06"
            android:gravity="center" />

    </LinearLayout>

    <!-- Version number -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="v1.0"
        android:textColor="#33FFFFFF"
        android:textSize="11sp"
        android:alpha="0"
        android:id="@+id/versionText"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
